<?xml version="1.0" encoding="utf-8"?>
<!--
    Colores - Calculadora BREAK
    Paleta minimalista y de alto contraste:
    fondo claro, textos oscuros y botón primario destacado
    (colores corporativos básicos de la cafetería).
-->
<resources>

    <!-- Colores base del sistema -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Fondo general de la pantalla (claro, bajo esfuerzo visual) -->
    <color name="background">#FFF5F1E8</color>

    <!-- Textos principales y secundarios (oscuros, alto contraste) -->
    <color name="text_primary">#FF3E2723</color>
    <color name="text_secondary">#FF8D6E63</color>

    <!-- Marrón corporativo de la cafetería (botón primario) -->
    <color name="primary">#FF6D4C41</color>
    <!-- Marrón más oscuro para el efecto de botón presionado -->
    <color name="primary_dark">#FF4E342E</color>

    <!-- Fondo suave para las filas de resultados -->
    <color name="result_row_background">#FFEFEBE9</color>

    <!-- Marrón intenso para resaltar el total a pagar -->
    <color name="total_accent">#FFBF360C</color>

</resources>